#include <limits.h>
#include <stdio.h>

void check_integer_representation() {
    // 2의 보수 표현 방식 확인
    if (INT_MIN == -INT_MAX - 1) {
        printf("2의 보수입니다.\n");
    }
    // 1의 보수 표현 방식 확인
    else if (INT_MIN == ~(INT_MAX)) {
        printf("1의 보수입니다.\n");
    }
 
}

int main() {
    check_integer_representation();
    return 0;
}

